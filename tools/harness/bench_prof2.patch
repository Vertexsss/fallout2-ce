+static int pathfinderFindPathClassic(Object* object, int from, int to, unsigned char* rotations, int requireEmptyDest, PathBuilderCallback* callback)
+{
+    if (requireEmptyDest) {
+        if (callback(object, to, object->elevation) != nullptr) {
+            return 0;

+
+        if (rotations != nullptr) {
+            unsigned char* beginning = rotations;
+            unsigned char* ending = rotations + index - 1;
+            int middle = index / 2;
+            for (int index = 0; index < middle; index++) {
+                unsigned char rotation = *ending;
+                *ending = *beginning;
+                *beginning = rotation;
+
+                ending -= 1;
+                beginning += 1;
+            }
+        }
+
+        return index;
+    }
+
+    return 0;

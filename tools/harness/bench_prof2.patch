+int pathfinderFindPath(Object* object, int from, int to, unsigned char* rotations, int requireEmptyDest, PathBuilderCallback* callback)
+{
+    static unsigned char classicRotations[800];
+    static unsigned char newRotations[800];
+    memset(classicRotations, 0xEE, sizeof(classicRotations));
+    memset(newRotations, 0xEE, sizeof(newRotations));
+
+    Object* mbSaved = _moveBlockObj;
+    double t0 = profNow();
+    int classicLen = pathfinderFindPathClassic(object, from, to, rotations != nullptr ? classicRotations : nullptr, requireEmptyDest, callback);
+    double t1 = profNow();
+    Object* mbClassic = _moveBlockObj;
+    _moveBlockObj = mbSaved;
+    int newLen = pathfinderFindPathNew(object, from, to, rotations != nullptr ? newRotations : nullptr, requireEmptyDest, callback);
+    double t2 = profNow();
+    Object* mbNew = _moveBlockObj;
+    _moveBlockObj = mbClassic;
+    if (mbClassic != mbNew) {
+        gPathDiffMismatch++;
+        fprintf(stderr, "[pf] MISMATCH moveBlockObj from=%d to=%d\n", from, to);
+    }
+
+    gPathDiffCalls++;
+    gPathDiffClassicMs += t1 - t0;
+    gPathDiffNewMs += t2 - t1;
+    if (t1 - t0 > gPathDiffClassicMaxMs) gPathDiffClassicMaxMs = t1 - t0;
+    if (t2 - t1 > gPathDiffNewMaxMs) gPathDiffNewMaxMs = t2 - t1;
+    if (classicLen != 0) gPathDiffNonzero++;
+
+    bool same = classicLen == newLen;
+    if (same && rotations != nullptr && classicLen > 0) {
+        same = memcmp(classicRotations, newRotations, static_cast<size_t>(classicLen)) == 0;
+    }
+    if (!same) {
+        gPathDiffMismatch++;
+        fprintf(stderr, "[pf] MISMATCH from=%d to=%d req=%d classic=%d new=%d\n", from, to, requireEmptyDest, classicLen, newLen);
+    }
+    if (gPathDiffCalls % 2000 == 0) {
+        fprintf(stderr, "[pf] calls=%lld nonzero=%lld mismatch=%lld classic_ms=%.1f new_ms=%.1f max_classic=%.2f max_new=%.2f\n",
+            gPathDiffCalls, gPathDiffNonzero, gPathDiffMismatch, gPathDiffClassicMs, gPathDiffNewMs, gPathDiffClassicMaxMs, gPathDiffNewMaxMs);
+    }
+
+    if (rotations != nullptr && classicLen > 0) {
+        memcpy(rotations, classicRotations, static_cast<size_t>(classicLen));
+    }
+    return classicLen;
+}
